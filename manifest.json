{
  "manifest_version": 3,
  "name": "Phisappear",
  "version": "1.0.0",
  "description": "Phisappear help user to detect potential phishing link.",
  "permissions": ["tabs", "activeTab", "storage", "scripting", "notifications"],
   "host_permissions": [
    "<all_urls>"
  ],
  "background": {
    "service_worker": "scripts/securityLogic.js"
  },  
  "content_scripts": [
    {
      "matches": ["<all_urls>"],
      "js": ["scripts/securityDisplay.js"],
      "run_at": "document_idle"
    }
  ],
  "web_accessible_resources": [
    {
      "resources": [ 
      "hybrid_cnn_lstm_model.onnx",
      "scripts/ort.min.js",
      "scripts/ort-wasm.wasm",
      "scripts/ort-wasm-simd.wasm",
      "scripts/ort-wasm-threaded.wasm",
      "scripts/ort-wasm-simd-threaded.wasm"
    ],
      "matches": ["<all_urls>"]
    }
  ],
  "action": {
    "default_popup": "UI/popup.html",
    "default_icon": {
      "16": "images/Logo.png",
      "48": "images/Logo.png"
    }
  },
  "icons": {
    "16": "images/Logo.png",
    "48": "images/Logo.png"
  }

}